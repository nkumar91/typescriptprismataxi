model CouponUsage {
  id               BigInt    @id @default(autoincrement())
  coupon_id        BigInt
  coupon           Coupon    @relation(fields: [coupon_id], references: [id])
  user_id          BigInt
  booking_id       BigInt
  discount_applied Decimal   @db.Decimal(10, 2)
  created_at       DateTime? @default(now())

  @@index([coupon_id])
  @@index([user_id])
}
