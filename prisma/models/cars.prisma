enum FuelType {
  petrol
  diesel
  electric
  cng
  hybrid
}

enum Transmission {
  manual
  automatic
}

enum CarStatus {
  available
  booked
  maintenance
  inactive
}

model Car {
  id             BigInt     @id @default(autoincrement())
  uuid           String     @unique @db.Char(36)
  vendor_id      BigInt
  city_id        BigInt
  location_id    BigInt?
  name           String     @db.VarChar(100)
  brand          String     @db.VarChar(80)
  model          String     @db.VarChar(80)
  year           Int
  fuel_type      FuelType   @default(petrol)
  transmission   Transmission @default(manual)
  seats          Int        @default(5)
  price_per_day  Decimal    @db.Decimal(10, 2)
  security_deposit Decimal  @db.Decimal(10, 2)
  status         CarStatus  @default(available)
  features       Json?
  description    String?    @db.Text
  mileage        Decimal?   @db.Decimal(5, 2)
  is_featured    Boolean    @default(false)
  created_at     DateTime?  @default(now())
  updated_at     DateTime?  @updatedAt
  deleted_at     DateTime?
  car_image      CarImage[]

  @@index([vendor_id])
  @@index([city_id])
  @@index([location_id])
  @@index([fuel_type])
  @@index([transmission])
  @@index([status])
  @@index([is_featured])
}
