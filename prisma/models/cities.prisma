model City {
  id         BigInt     @id @default(autoincrement())
  name       String     @unique @db.VarChar(100)
  state      String     @db.VarChar(100)
  country    String     @default("IN") @db.Char(2)
  is_active  Boolean    @default(true)
  created_at DateTime?
  updated_at DateTime?
  location   Location[]
  cars       Car[]
}
